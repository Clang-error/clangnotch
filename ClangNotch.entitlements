<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime blocks the Location Services prompt outright without this;
	     CoreWLAN needs that grant to return the SSID. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Going to a session's tab in Terminal is an AppleScript (run by osascript, charged to
	     this app). Whether Hardened Runtime needs this for a child's Apple Events is not
	     documented, so it is here to be safe; the user still gets the Automation prompt. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
